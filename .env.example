# The zetta node under test. This is the API/web port — NOT the peer port:
# `--listen` sets the PEER port; the web UI and MCP stay on 4800.
ZETTA_BASE_URL=http://127.0.0.1:4800

# The owner bearer, printed once at node startup, for the /v1 setup calls the
# specs make to put a node into a known state.
ZETTA_TOKEN=

# The deployed design, for the parity project. Cross-origin by design — that
# requirement is what ruled Cypress out (oramasearch/zetta#970).
DESIGN_BASE_URL=https://oramadesign-system-production.up.railway.app/studio/
